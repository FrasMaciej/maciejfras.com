---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="page">
		<header>
			<a class="wordmark" href="/" aria-label="Maciej Fras home">mf<span>.</span></a>
			<a class="quiet-link" href="https://github.com/FrasMaciej">GitHub <span aria-hidden="true">↗</span></a>
		</header>

		<main id="main">
			<section class="intro" aria-labelledby="intro-title">
				<p class="eyebrow">A personal corner of the internet</p>
				<h1 id="intro-title">Hi, I’m Maciej<span>.</span></h1>
				<p class="lead">I like building things, learning along the way, and keeping things simple.</p>
			</section>

			<section class="detail" aria-labelledby="about-title">
				<h2 id="about-title">About</h2>
				<p>I’m Maciej Fras. This is my little home on the web — a place for the things I make, ideas I’m exploring, and whatever comes next.</p>
			</section>

			<section class="detail" aria-labelledby="elsewhere-title">
				<h2 id="elsewhere-title">Elsewhere</h2>
				<div>
					<p>You can find my code and projects on GitHub.</p>
					<a class="profile-link" href="https://github.com/FrasMaciej">github.com/FrasMaciej <span aria-hidden="true">↗</span></a>
				</div>
			</section>
		</main>

		<footer>
			<span>© {new Date().getFullYear()} Maciej Fras</span>
			<span>Keeping it simple.</span>
		</footer>
	</div>
</Layout>

<style>
	.page {
		width: min(100% - 3rem, 42rem);
		margin-inline: auto;
	}

	header, footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	header { padding-block: 2.5rem; }
	.wordmark { font-size: 1.75rem; font-weight: 750; letter-spacing: -0.1em; text-decoration: none; }
	.wordmark span, h1 span { color: var(--accent); }
	.quiet-link { color: var(--muted); font-size: 0.875rem; text-decoration: none; }
	.intro { padding-block: 5rem 4.5rem; }
	.eyebrow { color: var(--muted); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; }
	h1 { margin-block: 1.25rem; font-size: clamp(2.75rem, 8vw, 4rem); font-weight: 650; letter-spacing: -0.065em; line-height: 1.1; }
	.lead { max-width: 31rem; font-size: 1.375rem; line-height: 1.6; }
	.detail { display: grid; grid-template-columns: 7rem 1fr; gap: 1.5rem; padding-block: 2rem; border-top: 1px solid var(--border); }
	h2 { margin: 0; font-size: 0.875rem; font-weight: 600; line-height: 1.8; }
	p { margin: 0; color: var(--muted); }
	.profile-link { display: inline-block; margin-top: 0.75rem; text-underline-offset: 0.3em; text-decoration-color: var(--border); }
	.profile-link span { margin-left: 0.3rem; color: var(--accent); }
	footer { margin-top: 4rem; padding-block: 1.5rem 2rem; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.75rem; }

	@media (max-width: 480px) {
		header { padding-block: 1.5rem; }
		.intro { padding-block: 3.5rem; }
		.detail { grid-template-columns: 1fr; gap: 0.75rem; }
		footer { margin-top: 2.5rem; flex-wrap: wrap; }
	}
</style>
